overleaf/TCC2_Gian_Pedro_Rodrigues/*.idx
overleaf/TCC2_Gian_Pedro_Rodrigues/*.ilg
overleaf/TCC2_Gian_Pedro_Rodrigues/*.ind
overleaf/TCC2_Gian_Pedro_Rodrigues/*.lof
overleaf/TCC2_Gian_Pedro_Rodrigues/*.log
