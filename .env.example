# Copie para .env (na raiz do projeto) e preencha. O .env não é versionado.
# No GitHub Actions, as mesmas variáveis vêm dos segredos do repositório.

# --- Hugging Face (obrigatório para publicar) ---
# Token com permissão de ESCRITA nos datasets do projeto. Sem ele, dá para ler
# os dados públicos, mas não publicar camadas nem a Gold (publicar_hf.py,
# publicar_gold.py). O dashboards/scripts/preparar_dados.py também o usa, se
# existir, para ter um limite de requisições maior no Hub.
HF_TOKEN=

# --- Staging (opcional) ---
# Pasta para download e descompactação dos arquivos do FTP do MTE. Vazio = pasta
# temporária do sistema. Vale apontar para um disco com espaço: um ano da RAIS
# descompactado passa de 10 GB.
# STAGING_DIR=C:/staging_mtps

# --- Notificações (opcional) ---
# Bot do Telegram que avisa o resultado de cada etapa. Sem as duas, nada é enviado.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Todo o resto tem valor padrão no código e só precisa estar aqui para mudá-lo:
# FTP_HOST, FTP_BASE, FTP_TIMEOUT, FTP_MAX_RETRIES (_settings/config.py),
# PARQUET_COMPRESSION, PARQUET_COMPRESSION_LEVEL, PARQUET_ROW_GROUP_SIZE,
# DUCKDB_MEMORY_LIMIT, DUCKDB_THREADS e REPO_* (_utils/nuvem.py).

# As credenciais do Overleaf ficam em overleaf/.env (ver overleaf/.env.example).
